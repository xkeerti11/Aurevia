# Server Configuration
PORT=5000
NODE_ENV=production

# Database (PostgreSQL on Neon / Supabase / Railway)
DATABASE_URL="postgresql://username:password@host:5432/databasename?sslmode=require"

# Security & Authentication
JWT_SECRET="generate_a_random_32_character_secret_key_here"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Frontend API URL (for Vercel environment variables)
# VITE_API_BASE_URL=https://your-backend-railway-url.up.railway.app/api/v1
